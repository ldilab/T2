# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# GitHub Personal Access Token used by LeanDojo to scrape Lean 4 repository
# metadata without hitting GitHub's anonymous-API rate limits.
# Generate at: https://github.com/settings/tokens
#   - For public repos only, no scopes are required.
#   - Adding `public_repo` is explicit but optional.
GITHUB_ACCESS_TOKEN=

# (Optional) Direct provider API keys, used by LiteLLM if you skip the proxy.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
