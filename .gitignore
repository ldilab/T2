# Local experiment outputs — only the curated subset is checked in.
# Track results/informalize/.../results_merged.json (canonical inputs) and
# results/**/evaluation.summary.json (paper headline metrics).
results/**/results_merged.json
!results/informalize/**/results_merged.json
results/**/evaluation.json
results/**/results.md
results/**/beq_evaluation.json
results/**/beq_evaluation.summary.json

# Intermediate dataset stages — regenerated by src/preprocessing/
data/existing_datasets/
data/research_papers/
data/final_raw/
data/prev/

